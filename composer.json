{
    "name": "glueful/storage-azure",
    "description": "Azure Blob Storage driver for the Glueful framework.",
    "type": "glueful-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "keywords": [
        "storage",
        "azure",
        "blob",
        "flysystem",
        "glueful"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "azure-oss/storage-blob-flysystem": "^1.6"
    },
    "require-dev": {
        "glueful/framework": "^1.79",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "homepage": "https://github.com/glueful/storage-azure",
    "autoload": {
        "psr-4": {
            "Glueful\\Extensions\\StorageAzure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glueful\\Extensions\\StorageAzure\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist",
        "phpcbf": "vendor/bin/phpcbf --standard=PSR12 src",
        "phpcs": "vendor/bin/phpcs --standard=PSR12 src",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "glueful": {
            "name": "StorageAzure",
            "displayName": "Azure Blob Storage Driver",
            "description": "Azure Blob Storage driver for Glueful.",
            "version": "1.0.1",
            "categories": [
                "storage"
            ],
            "publisher": "glueful-team",
            "provider": "Glueful\\Extensions\\StorageAzure\\StorageAzureServiceProvider",
            "requires": {
                "glueful": ">=1.79.0",
                "extensions": []
            },
            "migrations": "none"
        }
    },
    "config": {
        "sort-packages": true
    }
}
